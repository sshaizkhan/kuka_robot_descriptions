<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="iisy_11_r1300">
  <xacro:arg name="prefix" default=""/>
  <xacro:include filename="$(find kuka_robot_descriptions)/urdf/iisy_11_r1300_macro.xacro"/>
  <link name="world"/>
  <xacro:iisy_11_r1300 prefix="$(arg prefix)" parent="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:iisy_11_r1300>
</robot>
