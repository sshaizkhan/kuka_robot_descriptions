<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- KUKA KR 5 arc HW - generated from RoboDK .robot -->
  <xacro:macro name="kr_5_arc_hw" params="prefix parent *origin">

    <material name="${prefix}kr_5_arc_hw_grey"><color rgba="0.85 0.85 0.85 1.0"/></material>

    <joint name="${prefix}base_joint" type="fixed">
