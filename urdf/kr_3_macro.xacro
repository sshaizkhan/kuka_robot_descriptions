<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- KUKA KR 3 - generated from RoboDK .robot -->
  <xacro:macro name="kr_3" params="prefix parent *origin">

    <material name="${prefix}kr_3_grey"><color rgba="0.85 0.85 0.85 1.0"/></material>

    <joint name="${prefix}base_joint" type="fixed">
