<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="lbr_iiwa_7_r800">
  <xacro:arg name="prefix" default=""/>
  <xacro:include filename="$(find kuka_robot_descriptions)/urdf/lbr_iiwa_7_r800_macro.xacro"/>
  <link name="world"/>
  <xacro:lbr_iiwa_7_r800 prefix="$(arg prefix)" parent="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:lbr_iiwa_7_r800>
</robot>
