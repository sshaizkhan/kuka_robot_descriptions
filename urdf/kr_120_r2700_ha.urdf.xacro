<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kr_120_r2700_ha">
  <xacro:arg name="prefix" default=""/>
  <xacro:include filename="$(find kuka_robot_descriptions)/urdf/kr_120_r2700_ha_macro.xacro"/>
  <link name="world"/>
  <xacro:kr_120_r2700_ha prefix="$(arg prefix)" parent="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:kr_120_r2700_ha>
</robot>
