<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="iisy_15_r930">
  <xacro:arg name="prefix" default=""/>
  <xacro:include filename="$(find kuka_robot_descriptions)/urdf/iisy_15_r930_macro.xacro"/>
  <link name="world"/>
  <xacro:iisy_15_r930 prefix="$(arg prefix)" parent="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:iisy_15_r930>
</robot>
