<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kr_10_r1100_sixx">
  <xacro:arg name="prefix" default=""/>
  <xacro:include filename="$(find kuka_robot_descriptions)/urdf/kr_10_r1100_sixx_macro.xacro"/>
  <link name="world"/>
  <xacro:kr_10_r1100_sixx prefix="$(arg prefix)" parent="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:kr_10_r1100_sixx>
</robot>
