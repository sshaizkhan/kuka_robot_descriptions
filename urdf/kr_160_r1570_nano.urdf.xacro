<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kr_160_r1570_nano">
  <xacro:arg name="prefix" default=""/>
  <xacro:include filename="$(find kuka_robot_descriptions)/urdf/kr_160_r1570_nano_macro.xacro"/>
  <link name="world"/>
  <xacro:kr_160_r1570_nano prefix="$(arg prefix)" parent="world">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:kr_160_r1570_nano>
</robot>
